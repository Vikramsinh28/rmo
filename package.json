{
  "name": "kostra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "instrumentation": {
    "client": "./src/instrumentation-client.ts",
    "server": "./src/instrumentation.ts"
  },
  "scripts": {
    "dev": "next dev",
    "check-types": "tsc --noEmit",
    "build": "next build && npm run verify-sitemap",
    "build:only": "next build",
    "start": "next start",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "seed": "prisma db seed",
    "lint": "eslint .",
    "generate": "prisma generate",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run type-check",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "jest --verbose --no-coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:local": "POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5434/rmo_kostra_test?schema=public TEST_APP_URL=http://localhost:3001 NODE_ENV=test npm run test",
    "verify-sitemap": "echo '✅ Checking sitemap generation...' && ls -la .next/server/app/sitemap.xml* && echo '✅ Sitemap generated successfully!' || echo '❌ Sitemap generation failed!'",
    "deploy": "bash deploy.sh",
    "release": "tsx release.js",
    "preview-sitemap": "cat .next/server/app/sitemap.xml.body 2>/dev/null || echo 'No sitemap found. Run npm run build first.'",
    "preview-robots": "cat .next/server/app/robots.txt.body 2>/dev/null || echo 'No robots.txt found. Run npm run build first.'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/client-ses": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@base-ui/react": "^1.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "^3.12.4",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-aria/datepicker": "^3.17.1",
    "@react-stately/datepicker": "^3.17.1",
    "@remixicon/react": "^4.9.0",
    "@sentry/nextjs": "^10.75.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "@types/bcryptjs": "^3.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "hls.js": "^1.7.3",
    "jose": "^6.1.0",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^3.3.1",
