// schema.prisma 

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma/generated"
}

enum UserRole {
  ADMIN
  USER
}

enum UserPlan {
  FREE
  PRO
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum ContactPurpose {
  ACCOUNT
  BILLING
  TECHNICAL_SUPPORT
  FEATURE_REQUEST
  BUG_REPORT
  GENERAL_INQUIRY
  OTHER
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RmoRole {
  SYSTEM_ADMIN
  SUPER_ADMIN
  DIVISION_ADMIN
  DIVISION_MONITOR
  LOBBY_USER
  CREW_USER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum OrgStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 Int                 @id @default(autoincrement())
  googleId           String?             @unique
  name               String
  email              String              @unique
  password           String? // Hashed password for non-Google users
  profilePicture     String? // URL to the profile picture
  role               UserRole            @default(USER)
  isOnboarded        Boolean             @default(false)
  credits            Float               @default(100.0) // Available credits
  stripeCustomerId   String?             @unique
  plan               UserPlan            @default(FREE)
  isOverDue          Boolean             @default(false)
  planExpiringAt     DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime? // Soft delete
  loginId            String?             @unique
  accountStatus      AccountStatus       @default(ACTIVE)
  rmoRole            RmoRole             @default(CREW_USER)
  homeZoneId         Int?
  homeDivisionId     Int?
  homeLobbyId        Int?
  files              File[]
  creditHistory      CreditHistory[]
  blogs              Blog[]
  contactSubmissions ContactSubmission[]
  emailTemplates     EmailTemplate[]
  campaigns          Campaign[]
  campaignRecipients CampaignRecipient[]
  homeZone           Zone?               @relation("HomeZone", fields: [homeZoneId], references: [id])
  homeDivision       Division?           @relation("HomeDivision", fields: [homeDivisionId], references: [id])
  homeLobby          Lobby?              @relation("HomeLobby", fields: [homeLobbyId], references: [id])
  auditLogs          AuditLog[]
  formsCreated       Form[]              @relation("FormCreator")
  formVersionsCreated FormVersion[]      @relation("FormVersionCreator")
  registersCreated   Register[]          @relation("RegisterCreator")
  submissionsAuthored Submission[]       @relation("SubmissionAuthor")
  enrollmentsReviewed CrewEnrollment[]   @relation("EnrollmentReviewer")
  sourceEnrollment   CrewEnrollment?     @relation("EnrollmentAccount")
  monitoredCalls     LobbyCall[]         @relation("CallMonitor")
  endedCalls         LobbyCall[]         @relation("CallEnder")
  recordingsStarted  RecordingSegment[]  @relation("RecordingStarter")
  recordingsStopped  RecordingSegment[]  @relation("RecordingStopper")
  roomParticipants   RoomParticipant[]
  aiJobsStarted      AIProcessingJob[]   @relation("AIJobStarter")
  faceEnrollments    UserFaceEnrollment[]

  @@index([rmoRole])
  @@index([accountStatus])
  @@index([homeDivisionId])
  @@index([homeLobbyId])
}

model Package {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  isFeatured     Boolean  @default(false)
  price          Decimal
  currencySymbol String   @default("$")
  features       Json // JSON array of features
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model File {
  id           Int       @id @default(autoincrement())
  userId       Int?
  filename     String
  originalName String
  mimeType     String
  size         Int // File size in bytes
  url          String? // Storage URL (S3, Supabase, etc.)
  metadata     Json? // Additional file metadata
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete
  user         User?     @relation(fields: [userId], references: [id])
}

model CreditHistory {
  id           Int                   @id @default(autoincrement())
  userId       Int
  type         CreditTransactionType
  operation    CreditOperation
  amount       Float // Amount of credits (positive for credit, negative for debit)
  balanceAfter Float // Balance after this transaction
  objectId     String? // Related object ID (messageId, searchQueryId, etc.)
  description  String? // Optional description
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum CreditTransactionType {
  CREDIT
  DEBIT
}

enum CreditOperation {
  INITIAL_CREDITS
}

model Blog {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String   @unique
  content      String
  tags         String[] // Tags stored as array
  blogImageUrl String?  @db.VarChar(255)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authorId     Int // References User

  author     User           @relation(fields: [authorId], references: [id])
  categories BlogCategory[]
}

model Category {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now()) @db.Timestamptz()
  updatedAt DateTime       @default(now()) @db.Timestamptz()
  blogs     BlogCategory[]
}

model BlogCategory {
  blogId     Int
  categoryId Int

  blog     Blog     @relation(fields: [blogId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([blogId, categoryId])
}

model EmailOTP {
  id         Int        @id @default(autoincrement())
  email      String
  otp        String
  purpose    OtpPurpose
  expiringAt DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([email, purpose])
  @@index([expiringAt])
}

model ContactSubmission {
  id         Int            @id @default(autoincrement())
  uuid       String         @unique @default(dbgenerated("gen_random_uuid()"))
  userId     Int? // Optional - if user is logged in
  name       String
  email      String
  purpose    ContactPurpose
  message    String
  status     ContactStatus  @default(NEW)
  adminNotes String? // Admin can add notes
  resolvedAt DateTime? // When the issue was resolved
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime? // Soft delete

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([purpose])
  @@index([createdAt])
}

enum EmailType {
  TRANSACTIONAL
  PROMOTIONAL
}

enum CampaignStatus {
  SCHEDULED
  SENT
  FAILED
  PARTIALLYSUCCESS
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  OPENED
  CLICKED
}

model EmailTemplate {
  id           Int       @id @default(autoincrement())
  userId       Int
  name         String
  subject      String
  fromEmail    String
  fromName     String
  replyToEmail String?
  emailType    EmailType @default(TRANSACTIONAL)
  body         String
  variables    String[] // Store variable names as array of strings
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete

  user      User       @relation(fields: [userId], references: [id])
  campaigns Campaign[]

  @@index([userId])
  @@index([emailType])
}

model Campaign {
  id              Int            @id @default(autoincrement())
  userId          Int
  name            String
  emailTemplateId Int
  description     String?
  status          CampaignStatus @default(SCHEDULED)
  scheduledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  emailTemplate EmailTemplate       @relation(fields: [emailTemplateId], references: [id])
  recipients    CampaignRecipient[]

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

model CampaignRecipient {
  id           Int                     @id @default(autoincrement())
  campaignId   Int
  userId       Int
  status       CampaignRecipientStatus @default(PENDING)
  emailBody    String? // Complete HTML email body
  errorMessage String? // Error message if email delivery fails
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([campaignId])
  @@index([userId])
  @@index([status])
}

model Zone {
  id        Int       @id @default(autoincrement())
  name      String
  code      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  divisions Division[]
  homeUsers User[]     @relation("HomeZone")
  crewEnrollments CrewEnrollment[]

  @@index([status])
}

model Division {
  id        Int       @id @default(autoincrement())
  zoneId    Int
  name      String
  code      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  zone            Zone             @relation(fields: [zoneId], references: [id])
  lobbies         Lobby[]
  homeUsers       User[]           @relation("HomeDivision")
  forms           Form[]
  formAssignments FormAssignment[]
  registers       Register[]
  submissions     Submission[]
  crewEnrollments CrewEnrollment[]
  lobbyCalls      LobbyCall[]
  aiEntitlement   DivisionAIEntitlement?
  aiJobs          AIProcessingJob[]
  faceEnrollments UserFaceEnrollment[]
  faceCollection  DivisionFaceCollection?

  @@unique([zoneId, code])
  @@index([zoneId])
  @@index([status])
}

model Lobby {
  id         Int       @id @default(autoincrement())
  divisionId Int
  name       String
  code       String
  status     OrgStatus @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  division        Division         @relation(fields: [divisionId], references: [id])
  homeUsers       User[]           @relation("HomeLobby")
  devices         Device[]
  formAssignments FormAssignment[]
  submissions     Submission[]
  crewEnrollments CrewEnrollment[]
  room            LobbyRoom?
  lobbyCalls      LobbyCall[]
  recordingSegments RecordingSegment[]
  aiJobs          AIProcessingJob[]

  @@unique([divisionId, code])
  @@index([divisionId])
  @@index([status])
}

enum DeviceType {
  CAMERA
  KIOSK
}

model Device {
  id           Int        @id @default(autoincrement())
  name         String
  deviceType   DeviceType
  lobbyId      Int
  streamUrl    String
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  lobby Lobby @relation(fields: [lobbyId], references: [id])

  @@index([lobbyId])
  @@index([deviceType])
  @@index([isActive])
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormPurpose {
  GENERAL
  CREW_ENROLLMENT
}

enum FormVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum RegisterStatus {
  ACTIVE
  INACTIVE
}

enum SubmissionStatus {
  PENDING
  COMPLETED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Form {
  id               Int        @id @default(autoincrement())
  name             String
  description      String     @default("")
  divisionId       Int?
  status           FormStatus  @default(DRAFT)
  purpose          FormPurpose @default(GENERAL)
  currentVersionId Int?        @unique
  createdById      Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  division        Division?        @relation(fields: [divisionId], references: [id])
  createdBy       User             @relation("FormCreator", fields: [createdById], references: [id])
  currentVersion  FormVersion?     @relation("CurrentFormVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions        FormVersion[]    @relation("FormVersions")
  assignments     FormAssignment[]
  registers       Register[]
  submissions     Submission[]
  crewEnrollments CrewEnrollment[]

  @@index([divisionId])
  @@index([status])
  @@index([purpose])
  @@index([createdById])
}

model FormVersion {
  id            Int               @id @default(autoincrement())
  formId        Int
  versionNumber Int
  schema        Json
  status        FormVersionStatus @default(DRAFT)
  createdById   Int
  createdAt     DateTime          @default(now())

  form        Form         @relation("FormVersions", fields: [formId], references: [id])
  createdBy   User         @relation("FormVersionCreator", fields: [createdById], references: [id])
  currentFor  Form?            @relation("CurrentFormVersion")
  submissions Submission[]
  crewEnrollments CrewEnrollment[]

  @@unique([formId, versionNumber])
  @@index([formId])
  @@index([status])
}

model FormAssignment {
  id         Int      @id @default(autoincrement())
  formId     Int
  divisionId Int
  lobbyId    Int?
  createdAt  DateTime @default(now())

  form     Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id])
  lobby    Lobby?   @relation(fields: [lobbyId], references: [id])

  @@index([formId])
  @@index([divisionId])
  @@index([lobbyId])
}

model Register {
  id          Int            @id @default(autoincrement())
  name        String
  description String         @default("")
  divisionId  Int
  formId      Int
  status      RegisterStatus @default(ACTIVE)
  createdById Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  division  Division @relation(fields: [divisionId], references: [id])
  form      Form     @relation(fields: [formId], references: [id])
  createdBy User     @relation("RegisterCreator", fields: [createdById], references: [id])

  @@index([divisionId])
  @@index([formId])
  @@index([status])
}

model Submission {
  id            Int              @id @default(autoincrement())
  formId        Int
  formVersionId Int
  divisionId    Int
  lobbyId       Int?
  submittedById Int
  submittedAt   DateTime         @default(now())
  status        SubmissionStatus @default(COMPLETED)
  answers       Json

  form        Form        @relation(fields: [formId], references: [id])
  formVersion FormVersion @relation(fields: [formVersionId], references: [id])
  division    Division    @relation(fields: [divisionId], references: [id])
  lobby       Lobby?      @relation(fields: [lobbyId], references: [id])
  submittedBy User        @relation("SubmissionAuthor", fields: [submittedById], references: [id])
  crewEnrollment CrewEnrollment?

  @@index([formId])
  @@index([formVersionId])
  @@index([divisionId, submittedAt])
  @@index([lobbyId])
  @@index([submittedById])
  @@index([status])
}

model CrewEnrollment {
  id                  Int              @id @default(autoincrement())
  publicCode          String           @unique
  fullName            String
  email               String
  phone               String
  employeeId          String
  staffNumber         String
  loginId             String
  requestedZoneId     Int
  requestedDivisionId Int
  requestedLobbyId    Int
  formId              Int?
  formVersionId       Int?
  formSubmissionId    Int?             @unique
  answers             Json
  status              EnrollmentStatus @default(PENDING)
  passwordHash        String
  reviewedById        Int?
  reviewedAt          DateTime?
  rejectionReason     String?
  createdUserId       Int?             @unique
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  requestedZone     Zone         @relation(fields: [requestedZoneId], references: [id])
  requestedDivision Division     @relation(fields: [requestedDivisionId], references: [id])
  requestedLobby    Lobby        @relation(fields: [requestedLobbyId], references: [id])
  form              Form?        @relation(fields: [formId], references: [id])
  formVersion       FormVersion? @relation(fields: [formVersionId], references: [id])
  formSubmission    Submission?  @relation(fields: [formSubmissionId], references: [id])
  reviewedBy        User?        @relation("EnrollmentReviewer", fields: [reviewedById], references: [id])
  createdUser       User?        @relation("EnrollmentAccount", fields: [createdUserId], references: [id])
  roomParticipants  RoomParticipant[]

  @@index([status])
  @@index([requestedDivisionId, status])
  @@index([email])
  @@index([loginId])
  @@index([createdAt])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

enum LobbyRoomStatus {
  ACTIVE
  DISABLED
}

enum LobbyPresence {
  ONLINE
  OFFLINE
  CONNECTING
}

enum LobbyCallStatus {
  RINGING
  CONNECTED
  ENDED
  FAILED
  CANCELLED
}

enum CallConnection {
  IDLE
  CONNECTED
  RECONNECTING
  DISCONNECTED
}

enum ParticipantType {
  DIVISION_MONITOR
  LOBBY_USER
  CREW_MEMBER
}

enum ParticipantStatus {
  JOINED
  LEFT
}

enum RecordingStatus {
  RECORDING
  COMPLETED
  FAILED
}

model LobbyRoom {
  id         Int             @id @default(autoincrement())
  lobbyId    Int             @unique
  roomKey    String          @unique
  status     LobbyRoomStatus @default(ACTIVE)
  presence   LobbyPresence   @default(OFFLINE)
  lastSeenAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  lobby        Lobby             @relation(fields: [lobbyId], references: [id])
  calls        LobbyCall[]
  participants RoomParticipant[]

  @@index([status])
  @@index([presence])
}

model LobbyCall {
  id            Int              @id @default(autoincrement())
  roomId        Int
  lobbyId       Int
  divisionId    Int
  monitorUserId Int
  status        LobbyCallStatus  @default(RINGING)
  connection    CallConnection   @default(IDLE)
  startedAt     DateTime         @default(now())
  acceptedAt    DateTime?
  endedAt       DateTime?
  endedById     Int?
  endReason     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  room         LobbyRoom          @relation(fields: [roomId], references: [id])
  lobby        Lobby              @relation(fields: [lobbyId], references: [id])
  division     Division           @relation(fields: [divisionId], references: [id])
  monitor      User               @relation("CallMonitor", fields: [monitorUserId], references: [id])
  endedBy      User?              @relation("CallEnder", fields: [endedById], references: [id])
  participants RoomParticipant[]
  recordings   RecordingSegment[]
  aiJobs       AIProcessingJob[]

  @@index([roomId])
  @@index([lobbyId, status])
  @@index([divisionId, status])
  @@index([monitorUserId])
  @@index([startedAt])
}

model RoomParticipant {
  id               Int               @id @default(autoincrement())
  roomId           Int
  callId           Int
  userId           Int?
  crewEnrollmentId Int?
  participantType  ParticipantType
  status           ParticipantStatus @default(JOINED)
  joinedAt         DateTime          @default(now())
  leftAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  room           LobbyRoom       @relation(fields: [roomId], references: [id])
  call           LobbyCall       @relation(fields: [callId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  crewEnrollment CrewEnrollment? @relation(fields: [crewEnrollmentId], references: [id])

  @@index([callId, status])
  @@index([roomId])
  @@index([userId])
  @@index([crewEnrollmentId])
}

model RecordingSegment {
  id           Int             @id @default(autoincrement())
  lobbyCallId  Int
  roomId       Int
  lobbyId      Int
  startedById  Int
  stoppedById  Int?
  startedAt    DateTime        @default(now())
  stoppedAt    DateTime?
  duration     Int?
  status       RecordingStatus @default(RECORDING)
  storageKey   String?
  fileSize     Int?
  failureReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  call      LobbyCall @relation(fields: [lobbyCallId], references: [id])
  lobby     Lobby     @relation(fields: [lobbyId], references: [id])
  startedBy User      @relation("RecordingStarter", fields: [startedById], references: [id])
  stoppedBy User?     @relation("RecordingStopper", fields: [stoppedById], references: [id])

  @@index([lobbyCallId, status])
  @@index([lobbyId])
  @@index([startedAt])
}

enum AIEntitlementStatus {
  ACTIVE
  INACTIVE
}

enum AIPlan {
  BASIC
  PREMIUM
  ENTERPRISE
}

/// Division-level paid AI monitoring entitlement. Feature flags only; no AI processing.
model DivisionAIEntitlement {
  id                  Int                 @id @default(autoincrement())
  divisionId          Int                 @unique
  enabled             Boolean             @default(false)
  plan                AIPlan              @default(BASIC)
  status              AIEntitlementStatus @default(INACTIVE)
  startsAt            DateTime?
  expiresAt           DateTime?
  faceIdentification  Boolean             @default(false)
  fatigueDetection    Boolean             @default(false)
  impairmentDetection Boolean             @default(false)
  behaviorMonitoring  Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([enabled])
}

enum AIProcessingStatus {
  STARTING
  RUNNING
  STOPPING
  STOPPED
  ERROR
}

/// Optional AI frame-processing job attached to a live LobbyCall. Never owns the call.
model AIProcessingJob {
  id               Int                @id @default(autoincrement())
  lobbyCallId      Int
  divisionId       Int
  lobbyId          Int
  startedById      Int
  status           AIProcessingStatus @default(STARTING)
  framesReceived   Int                @default(0)
  framesProcessed  Int                @default(0)
  processingFps    Float?
  lastFrameAt      DateTime?
  errorMessage     String?
  startedAt        DateTime           @default(now())
  stoppedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  call      LobbyCall @relation(fields: [lobbyCallId], references: [id], onDelete: Cascade)
  division  Division  @relation(fields: [divisionId], references: [id])
  lobby     Lobby     @relation(fields: [lobbyId], references: [id])
  startedBy User      @relation("AIJobStarter", fields: [startedById], references: [id])

  @@index([lobbyCallId, status])
  @@index([divisionId, status])
  @@index([lobbyId])
}

enum FaceEnrollmentStatus {
  NOT_ENROLLED
  PENDING
  ENROLLED
  FAILED
  DISABLED
}

enum FaceEnrollmentProvider {
  AWS_REKOGNITION
}

/// Per-division AWS Rekognition collection mapping. One collection per division.
model DivisionFaceCollection {
  id           Int      @id @default(autoincrement())
  divisionId   Int      @unique
  collectionId String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
}

/// Crew face identity mapping for AWS Rekognition. Raw images are not stored.
model UserFaceEnrollment {
  id             Int                    @id @default(autoincrement())
  userId         Int
  divisionId     Int
  status         FaceEnrollmentStatus   @default(NOT_ENROLLED)
  provider       FaceEnrollmentProvider @default(AWS_REKOGNITION)
  collectionId   String?
  providerFaceId String?
  failureReason  String?
  enrolledAt     DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id])

  @@index([userId, status])
  @@index([divisionId, status])
  @@index([providerFaceId])
}
