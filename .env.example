# LOCAL DEVELOPMENT
# Copy this file to .env. .env is gitignored.
# These values match docker-compose.yml. They are not production credentials.
# Do not point POSTGRES_URL at Railway Monitor or any remote database.

NODE_ENV=local
TEST_MODE=
NEXT_RUNTIME=node
NEXT_PUBLIC_APP_URL=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rmo_kostra_dev
POSTGRES_PORT=5434
POSTGRES_URL="postgresql://postgres:postgres@127.0.0.1:5434/rmo_kostra_dev?schema=public"

# Jest uses this database. docker-compose.yml creates it on a fresh volume.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/rmo_kostra_test?schema=public"

# Local LiveKit SFU from docker-compose.yml. These dev credentials only work
# with `livekit-server --dev`. Do not use them outside this machine.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

JWT_SECRET=local_dev_jwt_secret_change_me
JWT_KEY=boilerplate-token

IS_DEMO=
EMAIL_DRIVER=test
FROM_EMAIL=dev@localhost
FROM_EMAIL_NAME=Kostra Local
RESEND_API_KEY=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

NEXT_PUBLIC_FILE_STORAGE_DRIVER=
S3_PUBLIC_BUCKET_NAME=
S3_PRIVATE_BUCKET_NAME=
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

NEXT_PUBLIC_SENTRY_DSN=

# Same DigitalOcean TURN server as the railway monitoring apps.
TURN_URLS=turn:turn.railwaymonitor.in:3478?transport=udp,turn:turn.railwaymonitor.in:3478?transport=tcp,turn:turn.railwaymonitor.in:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpassword

# Phase 6 local AI frame consumer (docker compose service ai-service).
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=local-ai-service-token
AI_SERVICE_PORT=8090
AI_FRAME_INTERVAL_MS=1000
# DEVELOPMENT ONLY — synthesize frames inside the AI service without a camera.
AI_DEV_TEST_STREAM=false

# PRODUCTION
# Set these in the host environment, not in this example file.
# POSTGRES_URL must be the deployment database.
# JWT_SECRET must be a unique secret.
# Do not reuse the local postgres/postgres password.
